# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser versionado (já está no .gitignore).

SECRET_KEY=troque-esta-chave
FLASK_DEBUG=1
PORT=5000

# Banco de dados (padrão: SQLite, não exige instalação)
# MySQL: mysql+pymysql://usuario:senha@localhost:3306/viajai
# DATABASE_URL=sqlite:///backend/viajai.db

# Integração com IA — obtenha a chave em https://aistudio.google.com/apikey
# Sem a chave o assistente responde pelo motor local (AssistenteLocalService).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Envio do código de verificação: console (imprime no terminal) ou smtp
EMAIL_MODO=console
EMAIL_REMETENTE=nao-responda@viajai.app
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# Regras
SENHA_TAMANHO_MINIMO=6
CODIGO_VALIDADE_MINUTOS=15
