# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser versionado (já está no .gitignore).

SECRET_KEY=troque-esta-chave
FLASK_DEBUG=1
PORT=5000

# Banco de dados (padrão: SQLite, não exige instalação)
# MySQL: mysql+pymysql://usuario:senha@localhost:3306/viajai
# DATABASE_URL=sqlite:///backend/viajai.db

# Integração com IA — obtenha a chave em https://aistudio.google.com/apikey
# Sem a chave o assistente responde pelo motor local (AssistenteLocalService).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Envio do código de verificação: console (imprime no terminal) ou smtp
EMAIL_MODO=console
EMAIL_REMETENTE=nao-responda@viajai.app
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# Regras
SENHA_TAMANHO_MINIMO=6
CODIGO_VALIDADE_MINUTOS=15

# --- Integrações externas (mapas, geocodificação, clima, fotos) ---
# 0 desliga todas as chamadas externas.
INTEGRACOES_EXTERNAS=1
# Wikimedia e Nominatim exigem identificação com contato real:
HTTP_USER_AGENT=Viajai/2.0 (contato: seu-email@exemplo.com)
# Busca fotos reais da Wikimedia em segundo plano ao iniciar (só lugares sem foto)
FOTOS_SINCRONIZACAO_AUTOMATICA=1
# Opcionais: candidatas de foto que passam por curadoria (python -m tools.fotos)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Mapa (use um provedor próprio/contratado em produção)
# MAPA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Uploads
UPLOAD_TAMANHO_MAXIMO_MB=5
UPLOAD_MAXIMO_FOTOS=6
